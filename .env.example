ADMIN_USERNAME=<your admin username>
ADMIN_PASSWORD_HASH=<your admin password hash>
ADMIN_SECRET_KEY=<your admin secret key>
POSTGRES_HOST=<your postgres host or localhost>
POSTGRES_PORT=<your postgres port, default: 5432>
POSTGRES_USER=osmosmjerka
POSTGRES_PASSWORD=<your chosen DB password>
POSTGRES_DATABASE=osmosmjerka

# --- Self-service registration -----------------------------------------------
# Public base URL used to build the links in confirmation and reset emails.
APP_BASE_URL=https://osmosmjerka.app
# Initial default only: the root admin can open/close registration from System Settings,
# and once they do, the stored setting takes over.
REGISTRATION_ENABLED=true

# --- Outbound email ----------------------------------------------------------
# With SMTP_HOST unset, mail is written to the application log (including the link)
# instead of being sent - that keeps local development and the E2E suite working offline.
SMTP_HOST=<your smtp host>
SMTP_PORT=587
SMTP_USERNAME=<smtp user, omit for an unauthenticated relay>
SMTP_PASSWORD=<smtp password>
SMTP_SECURITY=starttls
MAIL_FROM=no-reply@osmosmjerka.app
MAIL_FROM_NAME=Osmosmjerka

# --- Login hardening ---------------------------------------------------------
# Consecutive failed logins before an account is locked, and for how long.
MAX_FAILED_LOGINS=10
LOGIN_LOCKOUT_MINUTES=15
# Sign-in attempts allowed per source IP per window. Raise it when many users share one
# address (a classroom behind NAT); the per-account lockout above is the real brute-force
# control and is unaffected.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# The same shared-address consideration applies to the sign-up endpoints. Per-account
# throttling and single-use expiring tokens are unaffected by these.
SIGNUP_ATTEMPTS_PER_HOUR=5
EMAIL_REQUESTS_PER_HOUR=5
TOKEN_REDEMPTIONS_PER_HOUR=20
# Reverse proxies in front of the app. X-Forwarded-For is read this many entries from
# the right, so a client-supplied prefix can't be used to dodge the per-IP rate limits.
# 0 ignores the header entirely and uses the socket peer address.
TRUSTED_PROXY_HOPS=1

# --- Background maintenance --------------------------------------------------
# Interval for purging expired notifications, teacher sets and account tokens. 0 disables.
MAINTENANCE_INTERVAL_SECONDS=21600
